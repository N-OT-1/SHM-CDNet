# Source whitelist: new files remain excluded until explicitly allowed.
*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/train.py
!/evaluate.py
!/shm/
!/shm/*.py
!/configs/
!/configs/*.py
!/tests/
!/tests/*.py

# Never include data, model files, images, records or credentials.
**/__pycache__/
**/*.pyc
**/*.pt
**/*.pth
**/*.pth.tar
**/*.ckpt
**/*.safetensors
**/*.onnx
**/*.png
**/*.jpg
**/*.jpeg
**/*.tif
**/*.tiff
**/*.pdf
**/*.xlsx
**/*.csv
**/*.json
**/*.log
**/.env*
**/*.pem
**/*.key
/data/
/ckpts/
/work_dirs/
/outputs/
